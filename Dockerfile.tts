FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-tts.txt requirements-publish.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-publish.txt

WORKDIR /app
ENTRYPOINT ["python", "scripts/build.py", "tts"]
